{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app01",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "67dc7826-0628-4245-9091-97ec555342c8","database_name": "web-app01" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "0b1c913811a34de5ba5c22a019ad7379" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
